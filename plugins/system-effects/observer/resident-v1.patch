+/// Serial resident outer protocol. Run-level protocol-v2 artifacts and verifier
+/// are unchanged. No recovery/global snapshots are admitted in this first mode.
+pub fn run_resident_stdio() -> Result<()> {
+    use bpf_observer_system_effects::{
+        enable_resident_resources, resident_resource_count, resident_resource_identity,
+        shutdown_resident_resources,
+    };
+    use std::collections::HashSet;
+    enable_resident_resources();
+    let (sender, receiver) = mpsc::sync_channel(1);
+    std::thread::spawn(move || {
+        let stdin = std::io::stdin();
+        let mut input = stdin.lock();
+        loop {
+            let result = read_protocol_line(&mut input).map_err(|error| format!("{error:#}"));
+            let failed = result.is_err();
+            if sender.send(result).is_err() || failed {
+                break;
+            }
+        }
+    });
+    let mut fingerprint: Option<String> = None;
+    let mut seen = HashSet::new();
+    let mut bindings = HashSet::new();
+    for sequence in 1u64.. {
+        let line = receiver
+            .recv()
+            .context("resident command reader ended")?
+            .map_err(|error| anyhow::anyhow!(error))?;
+        let start: ResidentCommand =
+            serde_json::from_slice(&line).context("resident START schema")?;
+        if start.command == "SHUTDOWN" && start.config_path.is_none() {
+            shutdown_resident_resources();
+            emit_line(&serde_json::json!({"resident_protocol": 1, "status": "CLOSED"}))?;
+            return Ok(());
+        }
+        if start.command != "START" {
+            bail!("resident expects START or SHUTDOWN");
+        }
+        if sequence > 4096 {
+            bail!("resident run bound reached; restart worker");
+        }
+        let path = start
+            .config_path
+            .context("resident START needs config_path")?;
+        let config = DeploymentObserverConfig::from_path(Path::new(&path))?;
+        if config.protocol_version != 2
+            || config.recovery.is_some()
+            || config.bpf_state_scope.is_some()
+            || config.filesystem_state_scope.is_some()
+            || config.linux_state_scope.is_some()
+            || config.profile != PolicyProfile::Balanced
+            || config.object_resolution_mode
+                != FileObjectResolutionMode::KernelObjectExpandedPartial
+        {
+            bail!("resident mode requires balanced expanded observation-only protocol v2");
+        }
+        let current = serde_json::to_string(&(
+            config.recorder_object_path.clone(),
+            config.recorder_object_sha256.clone(),
+            config.lifecycle_object_path.clone(),
+            config.lifecycle_object_sha256.clone(),
+            config.profile,
+            config.object_resolution_mode,
+        ))?;
+        if fingerprint.as_ref().is_some_and(|old| old != &current) {
+            bail!("resident immutable BPF configuration changed");
+        }
+        fingerprint = Some(current);
+        if !seen.insert(config.run_id.clone()) {
+            bail!("resident run_id replay");
+        }
+        let reused = resident_resource_count() == 2;
+        let (mut session, ready) = DeploymentSession::prepare(config)?;
+        if ready.registration_cgroup_ids.len() != 1
+            || !bindings.insert((ready.registration_cgroup_ids[0], ready.epoch))
+        {
+            bail!("resident cgroup/epoch reuse or multi-root request");
+        }
+        let nonce = ready.finish_nonce.clone();
+        emit_line(&ready)?;
+        let command = loop {
+            match receiver.try_recv() {
+                Ok(Ok(line)) => {
+                    break serde_json::from_slice::<FinishCommand>(&line)
+                        .context("resident FINISH schema")?
+                }
+                Ok(Err(error)) => bail!("resident FINISH read: {error}"),
+                Err(TryRecvError::Disconnected) => bail!("resident FINISH reader lost"),
+                Err(TryRecvError::Empty) => {
+                    session.poll_once()?;
+                }
+            }
+        };
+        let (_, _, terminal) = session.finish(command)?;
+        if resident_resource_count() != 2 {
+            bail!("resident resources not safely recycled");
+        }
+        emit_line(&terminal)?;
+        // This ACK is separate from v2 FINISHED. The Python caller must check
+        // it before authorizing the next run or releasing its execution lease.
+        emit_line(
+            &serde_json::json!({"resident_protocol": 1, "status": "IDLE",
+            "run_id": terminal.run_id, "epoch": ready.epoch, "finish_nonce": nonce,
+            "report_sha256": terminal.report_sha256,
+            "artifact_manifest_sha256": terminal.artifact_manifest_sha256,
+            "sequence": sequence, "kernel_objects_reused": reused,
+            "resident_resources": resident_resource_count(),
+            "resident_objects": resident_resource_identity()?}),
+        )?;
+    }
+    bail!("resident run bound reached; restart the worker");
+}
